#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
    &none &kp Q &kp W &kp E     &kp R     &kp T        &kp Y       &kp U    &kp I     &kp O   &kp P     &none
    &none &kp A &kp S &kp D     &kp F     &kp G        &kp H       &kp J    &kp K     &kp L   &kp SEMI  &none
    &none &kp Z &kp X &kp C     &kp V     &kp B        &kp N       &kp M    &kp COMMA &kp DOT &kp SLASH &none
                      &kp EQUAL &kp MINUS &lt 2 ENTER  &lt 1 SPACE &kp BSPC &kp LALT
                        >;
                };
                lower_layer {
                        bindings = <
    &none &kp N1     &kp N2   &kp N3   &kp N4   &kp N5    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &none
    &none &kp EXCL   &kp AT   &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &none
    &none &kp LSHIFT &kp LBKT &kp RBKT &kp LBRC &kp RBRC  &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &trans   &none
                              &trans   &trans   &trans    &trans    &trans   &kp DOT
                        >;
                };

                raise_layer {
                        bindings = <
    &none &kp F1     &kp F2       &kp F3       &kp F4  &kp F5  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &kp C_BRI_UP &none
    &none &kp F6     &kp F7       &kp F8       &kp F9  &kp F10 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &kp C_BRI_DN &none
    &none &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp F11 &kp F12 &kp HOME       &kp PG_DN      &kp PG_UP    &kp END         &kp BSLH     &none
                                  &kp meh      &kp DEL &trans  &mkp LCLK      &mkp RCLK      &none
                        >;
                };
        };
};
