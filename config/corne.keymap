#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
  quick_tap_ms = <200>;
  tapping-term-ms = <250>;
};

/ {
  hm: hold_mouse {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick_tap_ms = <200>;
    bindings = <&kp>, <&mkp>;
  };
};

#define meh LS(LA(LCTRL))

/ {
        combos {
            compatible = "zmk,combos";
            combo_esc {
                timeout-ms = <50>;
                key-positions = <2 3>;
                bindings = <&kp ESC>;
            };
            combo_grave {
                timeout-ms = <50>;
                key-positions = <4 5>;
                bindings = <&kp GRAVE>;
            };
            combo_tab {
                timeout-ms = <50>;
                key-positions = <14 15>;
                bindings = <&kp TAB>;
            };
            combo_dqt {
                timeout-ms = <50>;
                key-positions = <18 19>;
                bindings = <&kp DQT>;
            };
            combo_sqt {
                timeout-ms = <50>;
                key-positions = <19 20>;
                bindings = <&kp SQT>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
    &none &kp Q        &kp W &kp E           &kp R          &kp T        &kp Y       &kp U    &kp I     &kp O         &kp P            &none
    &none &kp A        &kp S &kp D           &kp F          &kp G        &kp H       &kp J    &kp K     &kp L         &mt LGUI SEMI    &none
    &none &mt LSHIFT Z &kp X &kp C           &kp V          &kp B        &kp N       &kp M    &kp COMMA &mt LCTRL DOT &mt RSHIFT SLASH &none
                             &mt LCTRL EQUAL &mt LGUI MINUS &lt 2 ENTER  &lt 1 SPACE &kp BSPC &hm LALT LCLK
                        >;
                };
                lower_layer {
                        bindings = <
    &none &kp N1     &kp N2   &kp N3   &kp N4   &kp N5    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &none
    &none &kp EXCL   &kp AT   &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &none
    &none &kp LSHIFT &kp LBKT &kp RBKT &kp LBRC &kp RBRC  &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &trans   &none
                              &trans   &trans   &trans    &trans    &trans   &kp DOT
                        >;
                };

                raise_layer {
                        bindings = <
    &none &kp F1     &kp F2       &kp F3       &kp F4  &kp F5  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &mo 3    &none
    &none &kp F6     &kp F7       &kp F8       &kp F9  &kp F10 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none    &none
    &none &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp F11 &kp F12 &kp HOME       &kp PG_DN      &kp PG_UP    &kp END         &kp BSLH &none
                                  &kp meh      &kp DEL &trans  &mkp LCLK      &mkp RCLK      &mkp LCLK
                        >;
                };

                config_layer {
                        bindings = <
    &none &none        &none        &none        &none        &none        &none &kp C_BRI_DN &kp C_BRI_UP &none &none &trans
    &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none        &none        &none &none &none
                                    &none        &bt BT_CLR   &trans       &none &none        &none
                        >;
                };
        };
};
